/*
   Game Player mSL Initialization file (the "Profile") - GM-Octo-2024
   A single file : all the tables (they are reset before this file is run), then the Studio pad.
   Built 2026-10-20 from config-Clips, config-ClSets, config-HP, config-SModes, config-PModes,
   config-Banks, config-Sensors and the previous GM_mSL_ini.mSL (kept as GM_mSL_ini.mSL.bak).
*/

var s = stralloc();
var id;
var z;

//#################### Clips (from config-Clips.mSL) ####################

/*
    Configuration des Clips
*/
id = "Configuration des Clips";
sprintf(s, "%s START", id);
GM_Log(s);

z = table(data(
//=========================================

Table Clips Clear

ClipDir "WAVES"   // relative : in the "Data" folder of the project





End


//=========================================
));


sprintf(s, "%s END - Res: %d", id, z);
GM_Log(s);

//#################### ClipSets (from config-ClSets.mSL) ####################

/*
    Configuration des ClipSets
*/
id = "Clipsets";
// sprintf(s, "%s START", id); GM_Log(s);

z = table(data(

//=========================================
    Table ClipSets Clear
        FIdent 10001
        Set 100 RRR  PLUC
        ClRange 0 9999
        Set 101 RRR  PLUC
        ClRange 0 9999
    End

//=========================================
));

sprintf(s, "%s - ClipSets - Res: %d", id, z);
GM_Log(s);

